# Copy to .env (gitignored) and edit.

# Sent as a User-Agent contact string on every UniProt/BRENDA request
# (UniProt's own REST docs ask for this; polite-pool convention shared with
# ../fair_ocean_agent). Leaving this unset falls back to a placeholder --
# fine for local pressure-testing, but set a real address before a large
# cluster run.
PHA_REFERENCE_CONTACT_EMAIL=REPLACE_WITH_CONTACT_EMAIL@example.org

PHA_REFERENCE_DATABASE_PATH=PHA_reference/pha_reference.sqlite
