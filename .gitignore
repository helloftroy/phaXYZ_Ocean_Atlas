# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Machine-specific, regenerated by cluster/setup_env.sh / install_mmseqs2.sh
cluster/env_activate.sh
cluster/.env_config
cluster/bin/
cluster/bin-gpu/

# Secrets / local config
.env

# The canonical database and everything derived from it are reproducible
# from BRENDA + UniProt via the pipeline (see README) -- not committed.
PHA_reference/pha_reference.sqlite
PHA_reference/pha_reference.sqlite-journal
PHA_reference/pha_reference.sqlite-wal
PHA_reference/pha_reference.sqlite-shm
PHA_reference/exports/*
!PHA_reference/exports/.gitkeep

# Raw source caches: BRENDA full JSON dump (~80MB compressed / ~700MB
# extracted) and any cached UniProt responses. Large, re-downloadable.
data/brenda/*
!data/brenda/.gitkeep
data/uniprot_cache/*
!data/uniprot_cache/.gitkeep

# Large local inputs and outputs for phaC TemStaPro runs. Keep these inside
# the project checkout on scratch, but do not commit them.
data/temstapro_inputs/*
!data/temstapro_inputs/.gitkeep
data/woa23/*
!data/woa23/.gitkeep
data/all_genomes/*
!data/all_genomes/.gitkeep
/temstapro/

logs/
*.log

# PHA_bioprospecting: reference/ is a symlink to ../PHA_reference (no
# duplication of the canonical database/exports -- the symlink itself is
# tiny and fine to commit). The downloaded discovery databases are huge
# (GOPC ~184GB, OMDBv2 NR100 ~49GB+4GB) and re-downloadable via
# scripts/download_gopc.sh / download_omdb.sh -- never committed. Manifests
# ARE committed (small, and they're the actual provenance record).
PHA_bioprospecting/databases/GOPC/raw/*
PHA_bioprospecting/databases/OMDBv2/*
!PHA_bioprospecting/databases/OMDBv2/download_manifest.tsv

# gopc_search/ and omdb_search/: everything here is generated by
# export-queries/gopc-build-db/gopc-search/gopc-combine (and the omdb-*
# equivalents) and fully reproducible from pha_reference.sqlite + the
# downloaded GOPC/OMDB targets -- queries and results are data products,
# not source, and target_db/ especially can be very large. Not committed.
PHA_bioprospecting/gopc_search/
PHA_bioprospecting/omdb_search/

# Scratch space for results scp'd back from the cluster for local
# inspection (e.g. a family's *_unique_targets.tsv) -- can be tens of MB,
# always reproducible by re-running the search or copying it back again.
# Not committed.
hpc_results/

# phac_recovery/: build_local_manifests.py's own outputs (the OMDB catalog
# it fetches, ~280MB uncompressed; other_pha_hits.tsv alone is ~18MB) and
# every later pipeline stage's outputs (target sequences, neighborhoods,
# hmmsearch results) are data products regenerated by running the
# scripts, not source -- only the scripts/README/HMMs themselves are
# committed.
phac_recovery/*.tsv
phac_recovery/*.tsv.gz
phac_recovery/*.txt
phac_recovery/*.faa
phac_recovery/*.domtbl
phac_recovery/target_db_subset/
