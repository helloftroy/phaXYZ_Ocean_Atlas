# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Machine-specific, regenerated by cluster/setup_env.sh / install_mmseqs2.sh
cluster/env_activate.sh
cluster/.env_config
cluster/bin/

# Secrets / local config
.env

# The canonical database and everything derived from it are reproducible
# from BRENDA + UniProt via the pipeline (see README) -- not committed.
PHA_reference/pha_reference.sqlite
PHA_reference/pha_reference.sqlite-journal
PHA_reference/pha_reference.sqlite-wal
PHA_reference/pha_reference.sqlite-shm
PHA_reference/exports/*
!PHA_reference/exports/.gitkeep

# Raw source caches: BRENDA full JSON dump (~80MB compressed / ~700MB
# extracted) and any cached UniProt responses. Large, re-downloadable.
data/brenda/*
!data/brenda/.gitkeep
data/uniprot_cache/*
!data/uniprot_cache/.gitkeep

logs/
*.log

# PHA_bioprospecting: reference/ is a symlink to ../PHA_reference (no
# duplication of the canonical database/exports -- the symlink itself is
# tiny and fine to commit). The downloaded discovery databases are huge
# (GOPC ~184GB, OMDBv2 NR100 ~49GB+4GB) and re-downloadable via
# scripts/download_gopc.sh / download_omdb.sh -- never committed. Manifests
# ARE committed (small, and they're the actual provenance record).
PHA_bioprospecting/databases/GOPC/raw/*
PHA_bioprospecting/databases/OMDBv2/*
!PHA_bioprospecting/databases/OMDBv2/download_manifest.tsv

# gopc_search/: everything here is generated by export-queries/gopc-build-db/
# gopc-search/gopc-combine and fully reproducible from pha_reference.sqlite +
# the downloaded GOPC target -- queries and results are data products, not
# source, and target_db/ especially can be very large (built from a ~184GB
# input). Not committed.
PHA_bioprospecting/gopc_search/
